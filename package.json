{
  "name": "alab-grades-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "check": "npm run lint && npm run lint:workflow && npm run format:check && npm run test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "eslint .",
    "lint:workflow": "node scripts/lint-workflow.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "actionlint": "^2.0.6",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
